{
  "name": "playwright-qa-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript test automation framework showcase: layered fixtures, page objects, API/WebSocket testing, isolated component harness, custom ESLint rules.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "app": "node demo-app/server.mjs",
    "test": "playwright test",
    "test:api": "playwright test --project=api --project=ws",
    "test:ui": "playwright test --project=chromium",
    "test:component": "playwright test --project=component",
    "test:visual": "playwright test --project=visual",
    "test:lint-rules": "node --test eslint-rules/tests/rules.test.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  }
}
