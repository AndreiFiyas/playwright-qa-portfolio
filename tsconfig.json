{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@api/*": ["src/api/*"],
      "@ui/*": ["src/ui/*"],
      "@ws/*": ["src/ws/*"],
      "@utils/*": ["src/utils/*"],
      "@fixtures/*": ["tests/fixtures/*"],
      "@mocks/*": ["src/mocks/*"],
      "@contracts/*": ["demo-app/contracts/*"]
    }
  },
  "include": ["src", "tests", "reporters", "demo-app/contracts", "playwright.config.ts", "merge.config.ts"]
}
